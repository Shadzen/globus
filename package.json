{
  "name": "globus",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-scripts.js && prettier --write \"dist/**/*.html\" --ignore-path .prettierignore",
    "build:agent": "node scripts/build-agent.js",
    "preview": "npx --yes serve dist -l 4323",
    "preview:agent": "npx --yes serve dist-agent -l 4322",
    "astro": "astro",
    "lint": "eslint src"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "globby": "^16.2.4",
    "photoswipe": "^5.4.4",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "astro-eslint-parser": "^3.1.0",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "sass-embedded": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
