    <section>
        <div class="section-container">
            <div class="custom-row _gap-8">
                <a href="#" class="button _sized">памятка по стране</a>
                <a href="#" class="button _sized">памятка по стране</a>
                <a href="#" class="button _sized">памятка по стране</a>
