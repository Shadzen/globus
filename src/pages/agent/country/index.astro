                <a href="#" class="button _sized">памятка по стране</a>
                <a href="#" class="button _sized">памятка по стране</a>
                <a href="#" class="button _sized">памятка по стране</a>
                <a href="#" class="button _sized">памятка по стране</a>
                <a href="#" class="button _sized">памятка по стране</a>
            </div>
        </div>
