---
interface Props {
    title: string
    narrowContainer?: boolean
    dark?: boolean
    titleAs?: 'h1' | 'h2'
}

const { title, narrowContainer = true, dark = false, titleAs = 'h2' } = Astro.props
const TitleTag = titleAs
---

<section class:list={['accordion-section', { _dark: dark }]}>
    <div class:list={['section-container', { _narrow: narrowContainer }]}>
        <TitleTag class:list={{ '_as-h2': titleAs === 'h1' }}>{title}</TitleTag>

        {
            Astro.slots.has('intro') && (
                <div class="accordion-section-intro">
                    <slot name="intro" />
                </div>
            )
        }

        <div class="accordion-section-content">
            <slot />
        </div>
    </div>
</section>

<style lang="scss" is:global>
    .accordion-section {
        @include adaptive(margin-top, 40, 40);
        @include flex-center;

        .section-container {
            @include side-paddings;
            width: 100%;

            &._narrow {
                width: 85%;
            }

            @include mobile {
                width: 100% !important;
            }
        }

        :is(h1, h2) {
            @include desktop {
                width: 90%;
                margin: 0 auto;
            }
        }

        .accordion-section-intro {
            @include adaptive(margin-top, 78, 40);
            margin-left: auto;
            margin-right: auto;
            // width: 80%;

            @include mobile {
                width: 100%;
            }

            p {
                @include adaptive(font-size, 20, 18);
            }

            ul {
                list-style: disc;
                @include adaptive(padding-left, 30, 24);
                gap: 0;
                @include adaptive(width, 70%, 100%);

                li {
                    @include adaptive(font-size, 20, 18);
                    padding: 0;
                    @include adaptive(margin-top, 6, 6);
                    @include adaptive(margin-bottom, 6, 6);

                    &::before {
                        display: none;
                    }
                }
            }

            // Links in running text match the surrounding p / li size
            a {
                font-size: inherit;
                line-height: inherit;
                white-space: normal;
            }

            a[href^='tel:'] {
                white-space: nowrap;
            }
        }

        .accordion-section-content {
            @include adaptive(margin-top, 44, 22);
        }

        &._dark {
            @include adaptive(padding-top, 60, 30);
            @include adaptive(padding-bottom, 60, 30);
            @include adaptive(margin-top, 60, 30);

            :is(h1, h2) {
                color: var(--color-globus-sand);
            }
        }
    }
</style>
