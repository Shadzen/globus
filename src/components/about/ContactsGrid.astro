---
// src/components/about/ContactsGrid.astro
import type { ImageMetadata } from 'astro'
import contactPhoto1 from '@/assets/images/about/contact-photo-1.jpg'

export interface ContactPerson {
    name: string
    position: string
    email: string
    phone: string
    image: ImageMetadata
}

interface Props {
    people?: ContactPerson[]
    standalone?: boolean
    title?: string
    description?: string
    headingLevel?: 'h2' | 'h3'
    // 4 — four cards per row, avatar above the text
    columns?: 3 | 4
    // Center incomplete rows (1 or 2 contacts)
    centered?: boolean
}

const defaultPeople: ContactPerson[] = [
    {
        name: 'Лавренчук Олеся',
        position: 'Заместитель директора по работе с клиентами',
        email: 'globus1@globus-tour.ru',
        phone: '+79130637740',
        image: contactPhoto1,
    },
    {
        name: 'Маковецкая Ульяна',
        position: 'Менеджер по туризму',
        email: 'globus40@globus-tour.ru',
        phone: '+79137907620',
        image: contactPhoto1,
    },
    {
        name: 'Курлович Снежана',
        position: 'Менеджер по туризму',
        email: 'globus38@globus-tour.ru',
        phone: '+79130637754',
        image: contactPhoto1,
    },
]

const {
    people = defaultPeople,
    standalone = false,
    title,
    description,
    headingLevel = 'h3',
    columns = 3,
    centered = false,
} = Astro.props
const NameTag = headingLevel
---

<section
    class:list={[
        'contacts-grid _dark',
        { _standalone: standalone, '_columns-4': columns === 4, _centered: centered },
    ]}
>
    {title && <h2 set:html={title} />}
    {description && <p set:html={description} />}

    {
        people.map((person) => (
            <div class="contact-card">
                <div class="contact-avatar">
                    <img src={person.image.src} alt={person.name} loading="lazy" />
                </div>
                <div class="contact-info">
                    <div class="contact-info-top">
                        <NameTag class:list={{ '_as-h3': headingLevel === 'h2' }}>{person.name}</NameTag>
                        <p>{person.position}</p>
                    </div>
                    <div class="contact-links">
                        <a href={`mailto:${person.email}`}>
                            {person.email}
                        </a>
                        <a href={`tel:${person.phone}`}>
                            {person.phone}
                        </a>
                        <a href={`tel:${person.phone}`}>
                            {person.phone}
                        </a>
                    </div>
                </div>
            </div>
        ))
    }
</section>

<style lang="scss" is:global>
    .contacts-grid {
        @include adaptive(padding-top, 80, 40);
        @include adaptive(padding-bottom, 80, 40);
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        @include adaptive(gap, 60, 30);
        // @include adaptive(row-gap, 80, 50);

        &._standalone {
            @include side-paddings;
            @include adaptive(margin-top, 80, 40);
        }

        @include mobile {
            grid-template-columns: 1fr;
        }

        > h2, > p {
            grid-column: 1 / -1;
            text-align: center;
            justify-self: center;
        }

        > h2 {
            @include adaptive(width, 90%, 100%);
        }

        > p {
            @include adaptive(width, 50%, 100%);
            color: var(--color-globus-light-blue) !important;
        }

        // 4 per row: the avatar goes above the text so the narrow card fits
        &._columns-4 {
            grid-template-columns: repeat(4, 1fr);

            @include mobile {
                grid-template-columns: 1fr;
            }

            .contact-card {
                @include desktop {
                    flex-direction: column;
                }
            }
        }

        // Cards centered in the row: one sits in the middle, two are symmetric around the center
        &._centered {
            --contacts-columns: 3;
            @include adaptive(--contacts-gap, 60, 30);
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: var(--contacts-gap);

            &._columns-4 {
                --contacts-columns: 4;
            }

            // Side margins complete title / description to a full row (same widths as the grid version)
            @include desktop {
                > h2 {
                    margin-inline: 5%;
                }

                > p {
                    margin-inline: 25%;
                }
            }

            .contact-card {
                flex: 0 0
                    calc(
                        (100% - (var(--contacts-columns) - 1) * var(--contacts-gap)) /
                            var(--contacts-columns)
                    );

                @include mobile {
                    flex-basis: 100%;
                }
            }
        }
    }

    .contact-card {
        display: flex;
        @include adaptive(gap, 30, 24);
    }

    .contact-avatar {
        @include adaptive(width, 115, 111);
        @include adaptive(height, 115, 111);
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;

        img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        @include adaptive(gap, 24, 24);
        flex: 1;

        .contact-info-top {
            display: flex;
            flex-direction: column;

            :is(h2, h3) {
                @include adaptive(font-size, 28, 26);
                color: var(--color-globus-sand);
                width: 50%;

                @include mobile {
                    width: 100%;
                }
            }

            p {
                @include adaptive(font-size, 26, 18);
                color: var(--color-globus-light-blue);
            }
        }

        .contact-links {
            display: flex;
            flex-direction: column;
            @include adaptive(gap, 5, 5);
            margin-top: auto;

            a {
                color: var(--color-globus-cream);
                text-decoration: none;
            }
        }
    }
</style>
