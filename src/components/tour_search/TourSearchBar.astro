---
import arrowUpSmall from '@/assets/icons/arrow-up-small.svg'
import arrowDownSmall from '@/assets/icons/arrow-down-small.svg'

interface Props {
    userType?: 'tourist' | 'agent'
}

const { userType = 'agent' } = Astro.props
const base = import.meta.env.BASE_URL

const infoData = {
    date: '12.12.2025',
    eur: '96.19',
    usd: '82.12',
}

const buttons = [
    { label: 'Данные агентства', href: `${base}${userType}/tour_search_data/` },
    { label: 'Заявки', href: `${base}${userType}/tour_search_requests/` },
    { label: 'Поиск', href: `${base}${userType}/tour_search/` },
]
---

<div class="tour-search-bar _default-paddings">
    <div class="tour-search-items">
        <div class="tour-search-field">
            <span class="tour-search-label">Дата</span>
            <div class="tour-search-value-wrapper">
                <p class="tour-search-value">{infoData.date}</p>
                <div class="tour-search-underline"></div>
            </div>
        </div>

        <div class="tour-search-field">
            <span class="tour-search-label">EUR</span>
            <div class="tour-search-value-wrapper">
                <div class="tour-search-value-with-icon">
                    <p class="tour-search-value">{infoData.eur}</p>
                    <img src={arrowUpSmall.src} alt="↑" class="tour-search-icon" />
                </div>
                <div class="tour-search-underline"></div>
            </div>
        </div>

        <div class="tour-search-field">
            <span class="tour-search-label">USD</span>
            <div class="tour-search-value-wrapper">
                <div class="tour-search-value-with-icon">
                    <p class="tour-search-value">{infoData.usd}</p>
                    <img src={arrowDownSmall.src} alt="↓" class="tour-search-icon" />
                </div>
                <div class="tour-search-underline"></div>
            </div>
        </div>
    </div>

    <div class="tour-search-buttons">
        {
            buttons.map((button) => (
                <a href={button.href} class="button _outline _compact">
                    <span>{button.label}</span>
                </a>
            ))
        }
    </div>
</div>

<style lang="scss" is:global>
    .tour-search-bar {
        background-color: var(--color-globus-blue);
        @include adaptive(padding-top, 25, 25);
        @include adaptive(padding-bottom, 25, 25);
        @include side-paddings;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        @include adaptive(gap, 20, 25);

        @include mobile {
            flex-direction: column;
            align-items: stretch;
        }

        .tour-search-items {
            display: flex;
            @include adaptive(gap, 70, 30);
            align-items: center;
        }

        .tour-search-field {
            display: flex;
            align-items: center;
            @include adaptive(gap, 20, 16);
        }

        .tour-search-label {
            @include adaptive(font-size, 16, 14);
            color: color-mix(in srgb, var(--color-globus-cream) 55%, transparent);
            line-height: 1.6;
            text-transform: uppercase;
            @include adaptive(letter-spacing, 3.2, 2.8);
        }

        .tour-search-value-wrapper {
            display: flex;
            flex-direction: column;
            @include adaptive(gap, 8, 8);
            @include adaptive(min-width, 180, 0);
        }

        .tour-search-value-with-icon {
            display: flex;
            align-items: center;
            @include adaptive(gap, 10, 8);
        }

        .tour-search-value {
            @include adaptive(font-size, 26, 22);
            color: var(--color-globus-cream);
        }

        .tour-search-icon {
            @include adaptive(width, 8, 6);
            @include adaptive(height, 17, 14);
            display: block;
        }

        .tour-search-underline {
            width: 100%;
            height: 1px;
            background-color: var(--color-globus-sand);
        }

        .tour-search-buttons {
            display: flex;
            @include adaptive(gap, 16, 20);
            align-items: center;
            flex-wrap: wrap;

            @include mobile {
                flex-direction: column;
                width: 100%;
            }
        }

        .button._outline {
            color: var(--color-globus-sand) !important;
            @include adaptive(font-size, 16, 22);

            span {
                color: var(--color-globus-sand) !important;
            }
        }
    }
</style>
