---
interface Props {
    title?: string
}

const { title } = Astro.props
---

<section class="hero-section tour-search-hero">
    {title && (
        <div class="hero-content">
            <h2 class="hero-title">{title}</h2>
        </div>
    )}
</section>

<style lang="scss" is:global>
    .tour-search-hero.hero-section {
        // Compact header + sticky search bar clearance
        @include adaptive(padding-top, 256, 406);

        .hero-content {
            @include adaptive(margin-top, 60, 30);
        }

        .hero-title {
            color: var(--color-globus-blue);
            @include adaptive(font-size, 74, 60);
        }
    }
</style>
